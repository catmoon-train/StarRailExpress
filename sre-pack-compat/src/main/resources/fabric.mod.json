{
  "schemaVersion": 1,
  "id": "sre_pack_compat",
  "version": "${version}",
  "name": "SRE Pack Compat",
  "description": "整合包专用的资源与粒子兼容补丁，内置探囊取物快捷交换。",
  "authors": ["Catmoon Train Team", "Su_Crispy (Su's Instant Swap 原作者)", "supcherski (FramePacer)", "wifi-left (Skin Unlocker)"],
  "license": "GPL-3.0-only",
  "environment": "client",
  "accessWidener": "sre-pack-compat.accesswidener",
  "entrypoints": {
    "preLaunch": ["io.wifi.srepackcompat.SrePackCompatPreLaunch"],
    "client": ["io.wifi.srepackcompat.swap.InstantSwapClient", "io.wifi.srepackcompat.SrePackCompatClient"],
    "modmenu": ["io.wifi.srepackcompat.swap.SwapModMenu"]
  },
  "mixins": ["sre-pack-compat.mixins.json", "sre-pack-compat-particles.mixins.json", "sre-pack-compat-swap.mixins.json", "sre-pack-compat-chloride.mixins.json", "sre-pack-compat-settings.mixins.json", "sre-pack-compat-runtime.mixins.json", "sre-pack-compat-cobblemon.mixins.json"],
  "breaks": {},
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "chloride": "*",
    "modmenu": "*",
    "dashloader": "*",
    "particle_core": "*",
    "dsurround": "*",
    "moonlight": "*",
    "starrailexpress": "*"
  }
}
