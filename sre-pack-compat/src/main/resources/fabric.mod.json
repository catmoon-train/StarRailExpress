{
  "schemaVersion": 1,
  "id": "sre_pack_compat",
  "version": "${version}",
  "name": "SRE Pack Compat",
  "description": "整合包资源、输入、JEI 大厅与粒子兼容补丁。",
  "authors": ["Catmoon Train Team", "Su_Crispy (Su's Instant Swap 原作者)", "supcherski (FramePacer)", "wifi-left (Skin Unlocker)"],
  "license": "GPL-3.0-only",
  "environment": "*",
  "accessWidener": "sre-pack-compat.accesswidener",
  "entrypoints": {
    "preLaunch": ["io.wifi.srepackcompat.SrePackCompatPreLaunch"],
    "client": ["io.wifi.srepackcompat.swap.InstantSwapClient", "io.wifi.srepackcompat.SrePackCompatClient"],
    "modmenu": ["io.wifi.srepackcompat.swap.SwapModMenu"]
  },
  "mixins": [
    {"config": "sre-pack-compat.mixins.json", "environment": "client"},
    {"config": "sre-pack-compat-particles.mixins.json", "environment": "client"},
    {"config": "sre-pack-compat-swap.mixins.json", "environment": "client"},
    {"config": "sre-pack-compat-chloride.mixins.json", "environment": "client"},
    {"config": "sre-pack-compat-settings.mixins.json", "environment": "client"},
    {"config": "sre-pack-compat-runtime.mixins.json", "environment": "client"},
    {"config": "sre-pack-compat-jei.mixins.json", "environment": "client"},
    "sre-pack-compat-server.mixins.json"
  ],
  "breaks": {},
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "chloride": "*",
    "modmenu": "*",
    "dashloader": "*",
    "particle_core": "*",
    "dsurround": "*",
    "moonlight": "*",
    "starrailexpress": "*"
  }
}
