            "lines": [
              {
                "en_us": "Phase 1 — Chase the Killer: find the corpse's murderer and kill them with the one-use knife (a shield-blocked hit still counts as a kill) (killing the wrong person kills you; if you have a shield, you return to the initial phase)",
                "zh_cn": "阶段一——追凶：找到尸体的凶手，使用一次性刀完成击杀(被护盾挡掉伤害也算击杀)(误杀他人则自己死亡，如果自身有护盾则回到初始阶段)",
                "zh_tw": "階段一——追凶：找到屍體的兇手，使用一次性刀完成擊殺(被護盾擋掉傷害也算擊殺)(誤殺他人則自己死亡，如果自身有護盾則回到初始階段)"
              },
              {
                "en_us": "Phase 2 — Re-enact: after the kill, re-enact the same death as the corpse",
                "zh_cn": "阶段二——退戏：完成击杀后演绎与尸体一样的死法",
                "zh_tw": "階段二——退戲：完成擊殺後演繹與屍體一樣的死法"
              },
              {
                "en_us": "Phase 3 — Mortal Dream: fall asleep in a bed to win independently",
                "zh_cn": "阶段三——红尘梦：在床上入睡，获得独立胜利",
                "zh_tw": "階段三——紅塵夢：在床上入睡，獲得獨立勝利"
              }
            ]
          }
        },
