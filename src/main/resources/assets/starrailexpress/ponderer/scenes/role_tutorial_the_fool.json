              0,
              0,
              0
            ]
          }
        },
        {
          "type": "text",
          "duration": 151,
          "text": {
            "en_us": "The Fool can buy Name Vouchers (right-click to post on a wall)",
            "zh_cn": "愚者可购买尊名纸条(右键贴墙上)",
            "zh_tw": "愚者可購買尊名紙條(右鍵貼牆上)"
          },
          "point": [
            3.0,
            1.8,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 161
        },
        {
          "type": "text",
          "duration": 185,
          "text": {
            "en_us": "Other players near a voucher press J to pray and become members of the Tarot Cult",
            "zh_cn": "其他玩家在纸条附近按J键祷告成为塔罗会成员",
            "zh_tw": "其他玩家在紙條附近按J鍵禱告成為塔羅會成員"
          },
          "point": [
            3.0,
            2.08,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 195
        },
        {
          "type": "indicate_success",
          "blockPos": [
            3,
            0,
            3
          ]
        },
        {
          "type": "text",
          "duration": 190,
          "text": {
            "en_us": "The Fool can hold a Tarot Meeting while alive or dead (6 min cooldown while alive, 8 min after death)",
            "zh_cn": "愚者可以在存活时或死亡后按技能键召开塔罗会(愚者存活时开会冷却6分钟，死亡后开会冷却8分钟)",
            "zh_tw": "愚者可以在存活時或死亡後按技能鍵召開塔羅會(愚者存活時開會冷卻6分鐘，死亡後開會冷卻8分鐘)"
          },
          "point": [
            3.0,
            2.36,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 200
        },
        {
          "type": "text",
          "duration": 151,
          "text": {
            "en_us": "The meeting lasts 60 seconds; press G to settle the vote early",
            "zh_cn": "塔罗会持续60秒，愚者按G可提前结算投票",
            "zh_tw": "塔羅會持續60秒，愚者按G可提前結算投票"
          },
          "point": [
            3.0,
            2.64,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 161
        },
        {
          "type": "indicate_success",
          "blockPos": [
            3,
            0,
            3
          ]
        },
        {
          "type": "text",
          "duration": 158,
          "text": {
            "en_us": "All attendees may vote for any non-Fool player, including the dead",
            "zh_cn": "所有参会者可投票给任意非愚者玩家，包括死人",
            "zh_tw": "所有參會者可投票給任意非愚者玩家，包括死人"
          },
          "point": [
            3.0,
            2.92,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 168
        },
        {
          "type": "text",
          "duration": 190,
          "text": {
            "en_us": "On a tie, no votes, or if the top-voted player is already dead, the Fool receives a one-time pistol",
            "zh_cn": "平票、无人投票或票数最高者已死亡时，愚者会获得一把一次性手枪",
            "zh_tw": "平票、無人投票或票數最高者已死亡時，愚者會獲得一把一次性手槍"
          },
          "point": [
            3.0,
            3.2,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 200
        },
        {
          "type": "indicate_success",
          "blockPos": [
            3,
            0,
            3
          ]
        },
        {
          "type": "text",
          "duration": 190,
          "text": {
            "en_us": "If the top-voted player is alive, they are locked as the Heretic after voting; the Fool is immune to one hit from the Heretic",
            "zh_cn": "票数最高者存活时会在投票结束后被愚者锁定为异端，愚者免疫一次来自异端造成的一次伤害",
            "zh_tw": "票數最高者存活時會在投票結束後被愚者鎖定為異端，愚者免疫一次來自異端造成的一次傷害"
          },
          "point": [
            3.0,
            3.48,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 200
        },
        {
          "type": "rotate_camera_y",
          "degrees": 12.0,
          "duration": 50,
          "attachKeyFrame": true
        }
