        {
          "type": "text",
          "duration": 155,
          "text": {
            "en_us": "Start with players*300 coins; spend it all to win independently.",
            "zh_cn": "开局获得人数×300 的金币，花光全部金币即可独立获胜。",
            "zh_tw": "開局獲得人數×300 的金幣，花光全部金幣即可獨立獲勝。"
          },
          "point": [
            3.0,
            1.8,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 165
        },
        {
          "type": "text",
          "duration": 190,
          "text": {
            "en_us": "Shop: 400 coins for a shield stack (can't buy with an existing shield; 60s cd after it breaks).",
            "zh_cn": "商店花费 400 金币购买一层护盾：已有护盾时不可再买，护盾破损后进入 60 秒冷却。",
            "zh_tw": "商店花費 400 金幣購買一層護盾：已有護盾時不可再買，護盾破損後進入 60 秒冷卻。"
          },
          "point": [
            3.0,
            2.25,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
