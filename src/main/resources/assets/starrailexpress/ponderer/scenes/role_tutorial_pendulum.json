            "label": "ponder.starrailexpress.label.skill",
            "lines": [
              {
                "en_us": "Clock Lock: Invulnerable for 24 seconds. Each hit roots you for 1 second. On expiry or reactivation, rewind your position by the actual elapsed duration minus 3 seconds per hit, with a minimum rewind of zero. 90-second cooldown.",
                "zh_cn": "定钟：24秒内无敌，每次受击禁锢自身1秒。结束或再次释放时，回到本次实际持续时间减去每次受击3秒之前的位置，回溯最少为0秒。冷却90秒。",
                "zh_tw": "定鐘：24秒內無敵，每次受擊禁錮自身1秒。結束或再次釋放時，回到本次實際持續時間減去每次受擊3秒之前的位置，回溯最少為0秒。冷卻90秒。"
              },
              {
                "en_us": "Starts with a Second Needle, which only kills visible players within 3.5 blocks during the 6 seconds after their return. 5-second cooldown.",
                "zh_cn": "初始携带秒针，只能击杀3.5格内视线中被摆回后6秒内的玩家，冷却5秒。",
                "zh_tw": "初始攜帶秒針，只能擊殺3.5格內視線中被擺回後6秒內的玩家，冷卻5秒。"
              }
