        {
          "type": "starrailexpress:role_skill",
          "parameters": {
            "label": "ponder.starrailexpress.label.skill",
            "lines": [
              {
                "en_us": "Passive: every 10s drain electricity, making nearby lights flicker. After 10 drains you can call lightning.",
                "zh_cn": "被动：每10秒吞电一次，使周围灯光闪烁。积攒10次后可释放召雷。",
                "zh_tw": "被動：每10秒吞電一次，使周圍燈光閃爍。積攢10次後可釋放召雷。"
              },
              {
                "en_us": "Skill · Call Lightning: aim at a player and press the skill key, spending 10 drains and 100 coins to strike them. They randomly get one of: Slowness II (2 min), Blindness + Blind Sight (30s), Deafness (30s), Limp (30s).",
                "zh_cn": "技能·召雷：对准玩家按下技能键，消耗10次吞电与100金币，召唤闪电击中目标。目标随机获得以下一种残疾：缓慢II（2分钟）、失明+盲视（30秒）、耳聋（30秒）、腿瘸（30秒）。",
                "zh_tw": "技能·召雷：對準玩家按下技能鍵，消耗10次吞電與100金幣，召喚閃電擊中目標。目標隨機獲得以下一種殘疾：緩慢II（2分鐘）、失明+盲視（30秒）、耳聾（30秒）、腿瘸（30秒）。"
              }
            ]
          },
          "attachKeyFrame": true
        },
