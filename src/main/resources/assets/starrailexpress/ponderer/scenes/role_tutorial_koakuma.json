            "label": "ponder.starrailexpress.label.vision",
            "lines": [
              {
                "en_us": "Skill · Prank: you can mark one player. The next time Pachuri divines, the result will be fixed to that player.",
                "zh_cn": "技能 · 恶作剧：你可以标记一个玩家。该玩家被你标记后下一次帕秋莉预言时将固定为该玩家。",
                "zh_tw": "技能 · 惡作劇：你可以標記一個玩家。該玩家被你標記後下一次帕秋莉預言時將固定為該玩家。"
              },
              {
                "en_us": "You may mark exactly one player; marking another replaces the target.",
                "zh_cn": "你可以且仅可以标记一个玩家。标记一个玩家后再次标记另一个玩家将更换标记目标。",
                "zh_tw": "你可以且僅可以標記一個玩家。標記一個玩家後再次標記另一個玩家將更換標記目標。"
              },
              {
                "en_us": "If your marked player dies, Pachuri will divine you instead.",
                "zh_cn": "若你标记的玩家死亡，帕秋莉将会预言到你。",
                "zh_tw": "若你標記的玩家死亡，帕秋莉將會預言到你。"
              }
            ]
