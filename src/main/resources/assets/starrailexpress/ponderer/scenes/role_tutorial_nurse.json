              }
            ],
            "lines": [
              {
                "en_us": "You always see other players' virtual health bars and virtual shield bars",
                "zh_cn": "你始终能够看到其它玩家的虚拟血量条和虚拟护盾条",
                "zh_tw": "你始終能夠看到其他玩家的虛擬血量條和虛擬護盾條"
              },
              {
                "en_us": "You can see-through players within 30 blocks whose virtual health bar is not full (not 20)",
                "zh_cn": "你能够透视30格范围内虚拟血量条不为满(不为20)的玩家",
                "zh_tw": "你能夠透視30格範圍內虛擬血量條不為滿(不為20)的玩家"
              },
              {
                "en_us": "If a player died because their virtual health hit zero, you can see-through their corpse for up to 30 seconds",
                "zh_cn": "若玩家是因虚拟血量条归零而死的，你可以透视他的尸体至多30秒",
                "zh_tw": "若玩家是因虛擬血量條歸零而死的，你可以透視他的屍體至多30秒"
              },
              {
                "en_us": "Recovery Pill: eating it refills your own virtual health bar; press Q to throw it",
                "zh_cn": "康复药丸：食用后将自己的虚拟血量条补满，可以按Q键丢出",
                "zh_tw": "康復藥丸：食用後將自己的虛擬血量條補滿，可以按Q鍵丟出"
              },
              {
                "en_us": "Recovery Potion: thrown, players within a 4-block radius of the landing point gain virtual health regen for 30 seconds",
                "zh_cn": "康复试剂：丢出后使落地半径4格内的玩家获得虚拟血量恢复效果，持续30秒",
                "zh_tw": "康復試劑：丟出後使落地半徑4格內的玩家獲得虛擬血量恢復效果，持續30秒"
              }
            ]
          }
