      "title": {
        "en_us": "Programmer",
        "zh_cn": "程序员",
        "zh_tw": "程式員"
      },
      "steps": [
        {
          "type": "show_structure",
          "structure": "starrailexpress:role_tutorial_room",
          "scale": 1.0,
          "attachKeyFrame": true
