          }
        },
        {
          "type": "starrailexpress:role_panel",
          "attachKeyFrame": true,
          "parameters": {
            "title": "ponder.starrailexpress.label.notes",
            "lines": [
              {
                "en_us": "Hold the terminal and right-click to open it; type commands manually and press Enter (leading/trailing spaces ignored)",
                "zh_cn": "手持终端右键打开终端界面；指令需要自己手动输入，按回车执行（首尾多余空格会被自动忽略）",
                "zh_tw": "手持終端右鍵打開終端介面；指令需要自己手動輸入，按回車執行（首尾多餘空格會被自動忽略）"
              },
              {
                "en_us": "The terminal can spawn items (revolver, knives, lockpicks, handcuffs...), clear your status effects, cut lights out, disable monitors",
                "zh_cn": "终端能通过输入指令生成各种物品（左轮、刀具、开锁器、手铐……）、清除自身药效、切断全场照明、让监控失灵",
                "zh_tw": "終端能通過輸入指令生成各種物品（左輪、刀具、開鎖器、手銬……）、清除自身藥效、切斷全場照明、讓監控失靈"
              },
              {
                "en_us": "Anyone can use the terminal, but only the programmer can type /help to see the command list; others must memorize it",
                "zh_cn": "无论谁拿到终端都能够使用，但只有程序员能在终端里输入 /help 查看指令清单，其他人得自己记",
                "zh_tw": "無論誰拿到終端都能夠使用，但只有程式員能在終端裏輸入 /help 查看指令清單，其他人得自己記"
              },
              {
                "en_us": "Correct commands consume the terminal and start a 2min cooldown; wrong ones also consume it but only 10s",
                "zh_cn": "指令正确则消耗终端并进入2分钟冷却；输错也会消耗终端，但冷却只有10秒",
                "zh_tw": "指令正確則消耗終端並進入2分鐘冷卻；輸錯也會消耗終端，但冷卻只有10秒"
              }
            ]
          }
        },
