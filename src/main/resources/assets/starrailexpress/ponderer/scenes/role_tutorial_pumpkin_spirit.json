            },
            "lines": [
              {
                "en_us": "Use the role skill key to become a real flying bat for 15 seconds, with a 30-second cooldown. Timers freeze while paused. Your exclusive shop sells only candy for 50 coins each. Another player eating candy you actually dropped grants you two pumpkins; eating it yourself grants none.",
                "zh_cn": "累计获得开局人数×5个南瓜即独立获胜",
                "zh_tw": "累計獲得開局人數×5個南瓜即獨立獲勝"
              }
            ],
            "cost": 0,
            "duration": 120
          },
          "attachKeyFrame": true
        },
        {
          "type": "starrailexpress:role_currency",
          "parameters": {
            "progress": [
              0.0,
              1.0
            ],
            "lines": [
              {
                "en_us": "你可以攻击3格内可见的存活玩家，为他戴上持续15秒的南瓜头并使你获得1个南瓜；每个目标冷却15秒，安全期无效。",
                "zh_cn": "你可以攻击3格内可见的存活玩家，为他戴上持续15秒的南瓜头并使你获得1个南瓜；每个目标冷却15秒，安全期无效。",
                "zh_tw": "你可以攻擊3格內可見的存活玩家，為他戴上持續15秒的南瓜頭並使你獲得1個南瓜；每個目標冷卻15秒，安全期無效。"
              },
              {
                "en_us": "按技能键变成蝙蝠并飞行15秒，冷却30秒。",
                "zh_cn": "按技能键变成蝙蝠并飞行15秒，冷却30秒。",
                "zh_tw": "按技能鍵變成蝙蝠並飛行15秒，冷卻30秒。"
              },
              {
                "en_us": "商店可购买糖果，丢出去的糖果被别人吃掉时会使你获得2个南瓜，自己吃不给南瓜。",
                "zh_cn": "商店可购买糖果，丢出去的糖果被别人吃掉时会使你获得2个南瓜，自己吃不给南瓜。",
                "zh_tw": "商店可購買糖果，丟出去的糖果被別人吃掉時會使你獲得2個南瓜，自己吃不給南瓜。"
              },
              {
                "en_us": "死亡后，玩家每次敲门有50%概率在会使你在敲门者身边复活，并为其佩戴上15秒的南瓜头。",
                "zh_cn": "死亡后，玩家每次敲门有50%概率在会使你在敲门者身边复活，并为其佩戴上15秒的南瓜头。",
                "zh_tw": "死亡後，玩家每次敲門有50%概率在會使你在敲門者身邊復活，並為其佩戴上15秒的南瓜頭。"
              },
              {
                "en_us": "平民击杀你会被戴20秒南瓜头并获得缓慢 I 20秒。",
                "zh_cn": "平民击杀你会被戴20秒南瓜头并获得缓慢 I 20秒。",
                "zh_tw": "平民擊殺你會被戴20秒南瓜頭並獲得緩慢 I 20秒。"
              },
              {
                "en_us": "场上有存活亡命徒时，你将立即死亡、期间无法敲门复活或获胜。",
                "zh_cn": "场上有存活亡命徒时，你将立即死亡、期间无法敲门复活或获胜。",
                "zh_tw": "場上有存活亡命徒時，你將立即死亡、期間無法敲門復活或獲勝。"
              }
            ]
