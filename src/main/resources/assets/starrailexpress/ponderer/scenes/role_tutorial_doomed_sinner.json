            0.0
          ],
          "count": 1,
          "item": "noellesroles:fake_knife",
          "linkId": "doomed_sinner_line_item_1",
          "attachKeyFrame": true
        },
        {
          "type": "text",
          "duration": 190,
          "text": {
            "en_us": "Each time you die from a new cause, you randomly gain one of: fake knife, fake gun, fake bat, fake crowbar, fake lockpick.",
            "zh_cn": "每次以新的死因死亡时，你会随机获得假刀、假枪、假棒球棍、假撬棍、假开锁器中的 1 个。",
            "zh_tw": "每次以新的死因死亡時，你會隨機獲得假刀、假槍、假棒球棍、假撬棍、假開鎖器中的 1 個。"
          },
          "point": [
            3.0,
            2.08,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 200
        },
        {
          "type": "text",
          "duration": 151,
          "text": {
            "en_us": "If you die 3 times from the [same] cause, you die permanently.",
