        {
          "type": "starrailexpress:role_disguise",
          "attachKeyFrame": true,
          "parameters": {
            "label": "职业改写",
            "lines": [
              {
                "en_us": "When the command block event starts, it randomly marks 1.5 times the original number of killers among the passengers as abnormal and attaches a hidden abnormal modifier.",
                "zh_cn": "命令方块事件开局会随机标记原杀手数量 1.5 倍的平民为异常，并挂上隐藏的异常修饰符。",
                "zh_tw": "命令方塊事件開局會隨機標記原殺手數量 1.5 倍的平民為異常，並掛上隱藏的異常修飾符。"
              }
            ]
          }
        },
        {
          "type": "text",
          "duration": 190,
          "text": {
            "en_us": "The passenger team can break the crack with weapons such as a pistol, a baton or nunchucks to add 1 to the destruction progress.",
            "zh_cn": "好人阵营可以用各类武器（如手枪、警棍、双截棍）击碎裂缝并使破坏进度+1。",
            "zh_tw": "好人陣營可以用各類武器（如手槍、警棍、雙截棍）擊碎裂縫並使破壞進度+1。"
          },
          "point": [
            3.0,
            1.8,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 200
        },
        {
          "type": "text",
          "duration": 190,
          "text": {
            "en_us": "When the command block event starts, it randomly marks 1.5 times the original number of killers among the passengers as abnormal and attaches a hidden abnormal modifier.",
            "zh_cn": "命令方块事件开局会随机标记原杀手数量 1.5 倍的平民为异常，并挂上隐藏的异常修饰符。",
            "zh_tw": "命令方塊事件開局會隨機標記原殺手數量 1.5 倍的平民為異常，並掛上隱藏的異常修飾符。"
          },
          "point": [
            3.0,
            2.08,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 200
        },
        {
          "type": "indicate_success",
          "blockPos": [
            3,
            0,
            3
          ]
        },
        {
          "type": "text",
          "duration": 190,
          "text": {
            "en_us": "One minute before becoming a killer, you turn into the neutral role \"Abnormal\" with no abilities and see the role you are about to become.",
            "zh_cn": "成为杀手前的一分钟，本人会变成没有任何能力的中立职业「异常」，并看到即将变成的职业。",
            "zh_tw": "成為殺手前的一分鐘，本人會變成沒有任何能力的中立職業「異常」，並看到即將變成的職業。"
          },
          "point": [
            3.0,
            2.36,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 200
        },
        {
          "type": "text",
          "duration": 190,
          "text": {
            "en_us": "Rewrites prefer enabled roles that have not appeared this round; once all of them have appeared they prefer roles with fewer accumulated uses and fewer living players, random among equals.",
            "zh_cn": "改写优先抽取本局未出现的启用职业；全部出现过后优先累计次数较少、当前存活人数较少的职业，同等条件下随机。",
            "zh_tw": "改寫優先抽取本局未出現的啟用職業；全部出現過後優先累計次數較少、當前存活人數較少的職業，同等條件下隨機。"
          },
          "point": [
            3.0,
            2.64,
            3.0
          ],
          "placeNearTarget": true,
          "attachKeyFrame": true
        },
        {
          "type": "idle",
          "duration": 200
        },
        {
          "type": "rotate_camera_y",
          "degrees": 12.0,
          "duration": 50,
          "attachKeyFrame": true
        }
      ]
