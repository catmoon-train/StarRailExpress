            "lines": [
              {
                "en_us": "Active - Toll the Bell: press the skill key to toll a bell, letting players within 15 blocks briefly see the game time for 15 seconds. 90s cooldown.",
                "zh_cn": "主动技能-敲钟：按下技能键敲钟，使15格内的玩家短暂透视游戏时间15秒，冷却90秒。",
                "zh_tw": "主動技能-敲鐘：按下技能鍵敲鐘，使15格內的玩家短暫透視遊戲時間15秒，冷卻90秒。"
              },
              {
                "en_us": "Gong: when struck, non-Civilian/non-Sheriff players within 15 blocks cannot use skills or inventory for 10 seconds. 120s cooldown.",
                "zh_cn": "锣：敲响后使15格内非平民/非警长阵营的玩家10秒内无法使用技能与背包。冷却120秒。",
