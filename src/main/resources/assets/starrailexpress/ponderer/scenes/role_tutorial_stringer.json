        {
          "type": "starrailexpress:role_skill",
          "parameters": {
            "label": "ponder.starrailexpress.label.skill",
            "lines": [
              {
                "en_us": "Tether: Select two players in your inventory. They cannot be more than 10 blocks apart for 60 seconds. 90-second cooldown.",
                "zh_cn": "牵线：打开背包选择两名玩家，使他们在60秒内不能相距超过10格，冷却90秒。",
                "zh_tw": "初始攜帶線軸和絲刃。線軸將最近被纏絲的玩家拽到身前，自身禁錮0.3秒，冷卻5秒。絲刃只能擊殺3.5格內視線中的被纏絲或被牽線玩家，冷卻10秒。"
              },
              {
                "en_us": "Starts with a Thread Spool and Thread Blade. The spool pulls the nearest entangled player in front of you and roots you for 0.3 seconds; 5-second cooldown. The blade only kills a visible entangled or tethered player within 3.5 blocks; 10-second cooldown.",
                "zh_cn": "初始携带线轴和丝刃。线轴将最近被缠丝的玩家拽到身前，自身禁锢0.3秒，冷却5秒。丝刃只能击杀3.5格内视线中的被缠丝或被牵线玩家，冷却10秒。",
                "zh_tw": "商店：開鎖器80金幣；絲線團250金幣，像手榴彈一樣投擲，禁錮範圍內玩家2秒並纏絲15秒。"
              }
            ]
